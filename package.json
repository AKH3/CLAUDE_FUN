{
  "name": "claude-fun",
  "version": "0.4.0",
  "description": "Drop-in visual skill-tree board for Claude Code: tiny JSON deltas in, live interactive canvas out.",
  "type": "module",
  "license": "MIT",
  "author": "AKH3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AKH3/CLAUDE_FUN.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "mcp",
    "kanban",
    "skill-tree",
    "react-flow",
    "board"
  ],
  "bin": {
    "claude-fun": "dist/cli.js",
    "cfun": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n engine,ui \"node --watch-path=src --import tsx src/cli.ts serve --no-open --port 4317\" \"vite\"",
    "build": "npm run build:cli && npm run build:ui",
    "build:ui": "vite build",
    "build:cli": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ui/tsconfig.json",
    "test": "vitest run",
    "demo": "node dist/cli.js demo",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "concurrently": "^10.0.6",
    "hono": "^4.13.13",
    "open": "^11.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  }
}
